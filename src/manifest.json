{
  "manifest_version": 3,
  "name": "PTIT Helper",
  "version": "2.0",
  "description": "Bộ công cụ tiện ích cho sinh viên PTIT",
  "author": "nvbangg (https://github.com/nvbangg)",
  "homepage_url": "https://chromewebstore.google.com/detail/ncckkgpgiplcmbmobjlffkbaaklohhbo",

  "permissions": ["storage"],

  "action": {
    "default_title": "PTIT Helper",
    "default_popup": "popup/popup.html"
  },

  "host_permissions": ["http://localhost:27121/*", "https://gwdu.ptit.edu.vn/*"],

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://code.ptit.edu.vn/*", "https://db.ptit.edu.vn/*"],
      "css": ["content/codeptit.css"],
      "js": ["content/codeptit.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://db.ptit.edu.vn/*"],
      "js": ["content/dbptit.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://code.ptit.edu.vn/*",
        "https://db.ptit.edu.vn/*",
        "https://qldt.ptit.edu.vn/*",
        "https://slink.ptit.edu.vn/*"
      ],
      "js": ["content/options-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://db.ptit.edu.vn/*",
        "https://qldt.ptit.edu.vn/*",
        "https://slink.ptit.edu.vn/*"
      ],
      "js": ["content/hide-grades.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://slink.ptit.edu.vn/*"],
      "js": ["content/slink-drl.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
